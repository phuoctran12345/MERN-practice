{
  "name": "nodejspro",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "^5.0.1",
    "express-fileupload": "1.4.0", 
    "mongoose": "^9.0.1"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "nodemon": "3.1.9",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec \"ts-node src/app.ts\"",
    "dev2": "node -r ts-node/register src/app.ts",
    "build": "tsc -p .",
    "start": "node ./dist/app.js",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register ./src/app.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,json",
    "ignore": [
      "node_modules",
      "dist"
    ],
    "exec": "node -r ts-node/register ./src/app.ts",
    "legacyWatch": true,
    "delay": 1000,
    "verbose": true
  }
}

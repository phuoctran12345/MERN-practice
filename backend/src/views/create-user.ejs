<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    </head>

    <body>
        <div style="width:600 ; margin: auto;">
            <h1>Create User</h1>

            <form action="/handle-create-user" method="post">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="fullName" type="text" class="form-control" placeholder="Enter full name">
                </div>

                <div class="mb-3">
                    <label for="emailInp" class="form-label">Email address</label>
                    <input name="email" type="email" class="form-control" id="emailInp">
                </div>

                <div class="mb-3">
                    <label for="passInp" class="form-label">Password</label>
                    <input name="password" type="password" class="form-control" id="passInp">
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </body>

</html>
// ==========================================
// SMART HOTEL - DATABASE DESIGN (FULL FIXED)
// Công cụ: dbdiagram.io
// ==========================================

// 1. QUẢN LÝ CÔNG TY
Table companies {
  id ObjectId [primary key]
  name varchar
  tax_id varchar [unique]
  address text
  representative varchar
  phone varchar
  email varchar
  isActive boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Indexes {
    tax_id [unique]
    isActive
  }
}

// 2. NGƯỜI DÙNG
Table users {
  id ObjectId [primary key]
  company_id ObjectId [ref: > companies.id, note: 'Optional - null cho customer']
  email varchar [unique]
  password_hash varchar
  firstName varchar
  lastName varchar
  role varchar [note: 'user, admin, hotel_owner, receptionist, manager']
  phone varchar
  address json 
  preferences json
  totalBookings integer [default: 0]
  totalSpent decimal [default: 0]
  lastLogin timestamp
  isActive boolean [default: true]
  emailVerified boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    email [unique]
    company_id
    role
    (company_id, role) [name: 'company_role_idx']
    isActive
  }
}

// 3. KHÁCH SẠN
Table hotels {
  id ObjectId [primary key]
  company_id ObjectId [ref: > companies.id]
  userId ObjectId [ref: > users.id]
  name varchar
  city varchar
  country varchar
  description text
  type varchar[]
  adultCount integer
  childCount integer
  facilities varchar[]
  pricePerNight decimal
  starRating integer
  imageUrls varchar[]
  location json
  contact json
  policies json
  amenities json
  totalBookings integer [default: 0]
  totalRevenue decimal [default: 0]
  averageRating decimal [default: 0]
  reviewCount integer [default: 0]
  occupancyRate decimal [default: 0]
  isActive boolean [default: true]
  isFeatured boolean [default: false]
  lastUpdated timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    userId
    city
    (city, starRating) [name: 'city_rating_idx']
    (pricePerNight, starRating) [name: 'price_rating_idx']
  }
}

// 4. PHÒNG
Table rooms {
  id ObjectId [primary key]
  hotel_id ObjectId [ref: > hotels.id]
  roomNumber varchar
  roomType varchar [note: 'SINGLE, DOUBLE, SUITE, DELUXE']
  basePrice decimal
  status varchar [default: 'AVAILABLE', note: 'AVAILABLE, OCCUPIED, MAINTENANCE, RESERVED']
  maxOccupancy integer
  bedType varchar
  amenities varchar[]
  floor integer
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    hotel_id
    (hotel_id, status) [name: 'hotel_status_idx']
    (hotel_id, roomType) [name: 'hotel_roomtype_idx']
    (hotel_id, roomNumber) [unique, name: 'hotel_roomnumber_unique']
    status
  }
}

// 5. ĐẶT PHÒNG
Table bookings {
  id ObjectId [primary key]
  userId ObjectId [ref: > users.id]
  hotelId ObjectId [ref: > hotels.id]
  roomId ObjectId [ref: > rooms.id, note: 'ID phòng cụ thể được đặt']
  firstName varchar
  lastName varchar
  email varchar
  phone varchar
  adultCount integer
  childCount integer
  checkIn timestamp
  checkOut timestamp
  totalCost decimal [note: 'Giá booking ban đầu']
  finalTotalCost decimal [note: 'Tổng tiền cuối (booking + services + extra charges)']
  status varchar [note: 'pending, confirmed, checked_in, completed, cancelled, refunded']
  paymentStatus varchar [note: 'pending, paid, failed, refunded']
  paymentMethod varchar [note: 'online, cash, card']
  paymentIntentId varchar [note: 'DEPRECATED: Stripe Payment Intent ID (giữ lại để tương thích)']
  orderCode integer [note: 'PayOS Order Code - thay thế paymentIntentId']
  promotionCode varchar [note: 'Mã giảm giá đã áp dụng (optional)']
  promotionId ObjectId [ref: > promotions.id, note: 'ID promotion đã áp dụng (optional)']
  specialRequests text
  cancellationReason text
  refundAmount decimal [default: 0]
  checkedInAt timestamp [note: 'Thời gian thực tế check-in']
  checkedOutAt timestamp [note: 'Thời gian thực tế check-out']
  notes text [note: 'Ghi chú khi check-out']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    userId
    hotelId
    roomId
    (userId, created_at) [name: 'user_bookings_idx']
    (hotelId, checkIn) [name: 'hotel_checkin_idx']
    (roomId, checkIn) [name: 'room_checkin_idx']
    status
    (status, created_at) [name: 'status_created_idx']
    paymentStatus
    (paymentStatus, created_at) [name: 'payment_status_created_idx']
    (checkIn, status) [name: 'checkin_status_idx']
    orderCode [note: 'Index cho PayOS queries']
    email
    checkIn
  }
}

// 6. HỢP ĐỒNG (CLM)
Table contracts {
  id ObjectId [primary key]
  company_id ObjectId [ref: > companies.id]
  customer_id ObjectId [ref: > users.id]
  hotel_id ObjectId [ref: > hotels.id]
  contractCode varchar [unique]
  status varchar [note: 'DRAFT, ACTIVE, EXPIRED, TERMINATED']
  signedAt Date
  effectiveDate Date
  expiryDate Date
  renewalDate Date
  fileUrl varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// 7. TÀI CHÍNH HỢP ĐỒNG (1-1 với Contract)
Table contract_financials {
  id ObjectId [primary key]
  contract_id ObjectId [ref: - contracts.id]
  rentAmount decimal
  deposit decimal
  paymentSchedule text
  currency varchar [default: 'VND']
}

// 8. PHÂN TÍCH AI (1-1 với Contract)
Table ai_contract_analysis {
  id ObjectId [primary key]
  contract_id ObjectId [ref: - contracts.id]
  summary text
  riskLevel varchar [note: 'LOW, MEDIUM, HIGH']
  riskTags varchar[]
  vectorId varchar
  lastAnalyzed timestamp
}

// 9. YÊU CẦU DỊCH VỤ (UC 8)
Table service_requests {
  id ObjectId [primary key]
  booking_id ObjectId [ref: > bookings.id]
  user_id ObjectId [ref: > users.id]
  hotel_id ObjectId [ref: > hotels.id]
  service_type varchar [note: 'room_service, laundry, cleaning, food, transport, minibar, other']
  description text
  price decimal
  status varchar [note: 'pending, in_progress, completed, cancelled']
  requested_at timestamp [default: `now()`]
  completed_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    booking_id
    (booking_id, status) [name: 'booking_status_idx']
    user_id
    (user_id, created_at) [name: 'user_requests_idx']
    hotel_id
    (hotel_id, status) [name: 'hotel_status_idx']
    service_type
    status
  }
}

// 10. KHUYẾN MÃI (UC 12)
Table promotions {
  id ObjectId [primary key]
  hotel_id ObjectId [ref: > hotels.id, note: 'null = áp dụng cho tất cả hotels']
  name varchar
  description text
  discount_type varchar [note: 'PERCENTAGE, FIXED_AMOUNT']
  discount_value decimal
  start_date timestamp
  end_date timestamp
  min_stay integer [note: 'Số đêm tối thiểu']
  max_usage integer [note: 'Số lần sử dụng tối đa']
  current_usage integer [default: 0]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    hotel_id
    (hotel_id, is_active) [name: 'hotel_active_idx']
    (start_date, end_date) [name: 'date_range_idx']
    (is_active, start_date, end_date) [name: 'active_date_idx']
    is_active
  }
}

// 11. NHẬT KÝ HỆ THỐNG
Table audit_logs {
  id ObjectId [primary key]
  user_id ObjectId [ref: > users.id]
  action varchar
  targetType varchar
  targetId varchar
  timestamp timestamp [default: `now()`]

  Indexes {
    user_id
    (user_id, timestamp) [name: 'user_timestamp_idx']
    targetType
    (targetType, targetId) [name: 'target_idx']
  }
}